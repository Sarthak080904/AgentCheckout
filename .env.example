# Backend (backend/.env)
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AGENT_MAX_AUTO_AMOUNT_INR=2000
# Demo aid only, leave at 0 normally. Set to 1 to see the automatic retry
# succeed silently; set to 2 to exhaust the retry and see the agent fail
# gracefully instead of the request 500ing.
SIMULATE_PAYMENT_FAILURES=0

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
